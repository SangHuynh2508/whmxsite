{"version":"r3177","asset_base_url":"https://pub-c0dceaa4fc5b48d1811c48f6f91a899c.r2.dev","id":"D0026","langs":[{"lang":"1005","name":"尤卡坦玛雅语","cv":"李善真","lines":[{"skin":"D0026001","type":"dropLine","order":1,"label":"招集","text":"太阳依旧升起，你好，我是玛雅文字陶碗。","key":"voice/d0026/1005/d0026001_dropLine.mp3"},{"skin":"D0026001","type":"regardsLine","order":2,"label":"问候","text":"可可是货币，是食物，也可以是礼物。","key":"voice/d0026/1005/d0026001_regardsLine.mp3"},{"skin":"D0026001","type":"appointmentLine","order":3,"label":"任命","text":"我更擅长耕种和雕刻的活动，不过，我会听你的话试试。","key":"voice/d0026/1005/d0026001_appointmentLine.mp3"},{"skin":"D0026001","type":"touchLine_1","order":4,"label":"交谈1","text":"我在回想已经不复存在的田地，族人和我的家，再也没有人像那样交谈天气和作物，他们已经走向黑夜。","key":"voice/d0026/1005/d0026001_touchLine_1.mp3"},{"skin":"D0026001","type":"touchLine_2","order":5,"label":"交谈2","text":"在我们的祈祷下，羽蛇神腾空而起，飞越高高的树梢，在天空中翱翔，它带来闪电与雨水，新的季节到来了，作物生长。","key":"voice/d0026/1005/d0026001_touchLine_2.mp3"},{"skin":"D0026001","type":"touchLine_3","order":6,"label":"交谈3","text":"太阳的光辉照耀着大地，谷物生长，我们制作了陶器，在石碑上刻下我们的文字，以此歌颂太阳。","key":"voice/d0026/1005/d0026001_touchLine_3.mp3"},{"skin":"D0026001","type":"touchLine_4","order":7,"label":"投契之谈","text":"现在的人在可可里加了牛奶和糖，很多人喜欢吃可可，我会想念加了辣椒和香料的可可，那时候大家都喜欢这样的可可。","key":"voice/d0026/1005/d0026001_touchLine_4.mp3","unlock":"感应达到投契解锁"},{"skin":"D0026001","type":"touchLine_5","order":8,"label":"鹿鸣之谈","text":"玉米神将玉米赐予我们，它指引着玉米破土，发芽，整齐地排列在田地中，成为我们生命的养料。玉米神不断重生，祂永远年轻，鲜活，美丽，就像我们种下的玉米一样。","key":"voice/d0026/1005/d0026001_touchLine_5.mp3","unlock":"感应达到鹿鸣解锁"},{"skin":"D0026001","type":"touchLine_6","order":9,"label":"莫逆之谈","text":"太阳神，离开了我们，祂从高高的天上落下来，顺着河流远去了。太阳的光辉不再照耀我们的大地，我们抛弃了我们的宫殿和神庙，迁徙到新的土地。但太阳神已经离去，新的森林覆盖了一切。","key":"voice/d0026/1005/d0026001_touchLine_6.mp3","unlock":"感应达到莫逆解锁"},{"skin":"D0026001","type":"timeLine_1","order":10,"label":"时段交谈1","text":"阳光正照耀着大地。","key":"voice/d0026/1005/d0026001_timeLine_1.mp3","zone":"6:00–18:00"},{"skin":"D0026001","type":"timeLine_2","order":11,"label":"时段交谈2","text":"夜晚是结束，也是开始。","key":"voice/d0026/1005/d0026001_timeLine_2.mp3","zone":"18:00–23:59"},{"skin":"D0026001","type":"unuseLine","order":12,"label":"独处","text":"巧克力？","key":"voice/d0026/1005/d0026001_unuseLine.mp3"},{"skin":"D0026001","type":"levelUpLine","order":13,"label":"升级","text":"这和我们的语言如此不同，我尽力理解它们……","key":"voice/d0026/1005/d0026001_levelUpLine.mp3"},{"skin":"D0026001","type":"joinpLine","order":14,"label":"加入编队","text":"好多人。","key":"voice/d0026/1005/d0026001_joinpLine.mp3"},{"skin":"D0026001","type":"strengthenLine_1","order":15,"label":"致知提升","text":"婴儿出生之前，在母亲体内度过了一个卓尔金周期。我们为卓尔金周期内的日子命名，卓尔金日名决定了出生婴儿的命运，于是我们就有了风的孩子，夜晚的孩子，月亮的孩子，星辰的孩子。","key":"voice/d0026/1005/d0026001_strengthenLine_1.mp3","unlock":"知行合一解锁"},{"skin":"D0026001","type":"strengthenLine_2","order":16,"label":"焕彰","text":"13是每个循环的结束，在无数个卓尔金周期中，我们在无数个“1-13”循环反复，直至我们走向真正的终结。","key":"voice/d0026/1005/d0026001_strengthenLine_2.mp3","unlock":"焕彰·感闻解锁"},{"skin":"D0026001","type":"strengthenLine_3","order":17,"label":"精研","text":"我们预知死亡和终结，而不畏惧它们的到来，这是自然的决定，作为自然的孩子，我们受它指引，由它养育，我们服从自然的决定。","key":"voice/d0026/1005/d0026001_strengthenLine_3.mp3","unlock":"精研解锁"},{"skin":"D0026001","type":"equipLine_1","order":18,"label":"装备穿戴1","text":"新的武器。","key":"voice/d0026/1005/d0026001_equipLine_1.mp3"},{"skin":"D0026001","type":"equipLine_2","order":19,"label":"装备穿戴2","text":"是交易吗？","key":"voice/d0026/1005/d0026001_equipLine_2.mp3","unlock":"感应达到投契解锁"},{"skin":"D0026001","type":"displayLine_1","order":20,"label":"战斗登场1","text":"金星闪耀。","key":"voice/d0026/1005/d0026001_displayLine_1.mp3"},{"skin":"D0026001","type":"displayLine_2","order":21,"label":"战斗登场2","text":"不惧死亡。","key":"voice/d0026/1005/d0026001_displayLine_2.mp3","unlock":"感应达到推心解锁"},{"skin":"D0026001","type":"switchToLine","order":22,"label":"聚焦","text":"可可。","key":"voice/d0026/1005/d0026001_switchToLine.mp3"},{"skin":"D0026001","type":"switchToLine_2","order":23,"label":"聚焦2","text":"感受风和太阳。","key":"voice/d0026/1005/d0026001_switchToLine_2.mp3"},{"skin":"D0026001","type":"switchToLine_3","order":24,"label":"聚焦3","text":"大雨将至。","key":"voice/d0026/1005/d0026001_switchToLine_3.mp3"},{"skin":"D0026001","type":"skillLine","order":25,"label":"释放技能","text":"喝！","key":"voice/d0026/1005/d0026001_skillLine.mp3"},{"skin":"D0026001","type":"skillLine_2","order":26,"label":"释放技能2","text":"别逃。","key":"voice/d0026/1005/d0026001_skillLine_2.mp3"},{"skin":"D0026001","type":"beDyingLine","order":27,"label":"濒危","text":"受伤了……","key":"voice/d0026/1005/d0026001_beDyingLine.mp3"},{"skin":"D0026001","type":"skillReadyLine","order":28,"label":"绝技就绪","text":"准备迁徙。","key":"voice/d0026/1005/d0026001_skillReadyLine.mp3"},{"skin":"D0026001","type":"skillReadyLine_2","order":29,"label":"绝技就绪2","text":"顺水而下。","key":"voice/d0026/1005/d0026001_skillReadyLine_2.mp3"},{"skin":"D0026001","type":"victoryLine_1","order":30,"label":"破局成功1","text":"战争神的力量。","key":"voice/d0026/1005/d0026001_victoryLine_1.mp3"},{"skin":"D0026001","type":"victoryLine_2","order":31,"label":"破局成功2","text":"我的投枪，百发百中。","key":"voice/d0026/1005/d0026001_victoryLine_2.mp3","unlock":"感应达到推心解锁"},{"skin":"D0026001","type":"loseLine_1","order":32,"label":"破局失败1","text":"不是每次战役都会胜利。","key":"voice/d0026/1005/d0026001_loseLine_1.mp3"},{"skin":"D0026001","type":"loseLine_2","order":33,"label":"破局失败2","text":"对不起，没能抓住他们。","key":"voice/d0026/1005/d0026001_loseLine_2.mp3","unlock":"感应达到推心解锁"},{"skin":"D0026001","type":"enterInstallationLine","order":34,"label":"入驻","text":"这是新的家。","key":"voice/d0026/1005/d0026001_enterInstallationLine.mp3"},{"skin":"D0026001","type":"installationLine_1","order":35,"label":"设施会话1","text":"我正想象着，自己是一颗生长的玉米。","key":"voice/d0026/1005/d0026001_installationLine_1.mp3"},{"skin":"D0026001","type":"installationLine_2","order":36,"label":"设施会话2","text":"可可？","key":"voice/d0026/1005/d0026001_installationLine_2.mp3"},{"skin":"D0026001","type":"expeditionsucceedLine","order":37,"label":"远征成功","text":"要吃烤玉米庆祝……","key":"voice/d0026/1005/d0026001_expeditionsucceedLine.mp3","unlock":"功能模块开发中"},{"skin":"D0026001","type":"expeditionstartLine","order":38,"label":"远征出发","text":"太阳落山就会回来。","key":"voice/d0026/1005/d0026001_expeditionstartLine.mp3","unlock":"功能模块开发中"},{"skin":"D0026001","type":"expeditionbackLine","order":39,"label":"远征归来","text":"风指引我们归来。","key":"voice/d0026/1005/d0026001_expeditionbackLine.mp3","unlock":"功能模块开发中"},{"skin":"D0026001","type":"giftVictoryLine","order":40,"label":"感应1","text":"纸张和旭日一样年轻，故事和落日一样陈旧，我喜欢这样去注视。","key":"voice/d0026/1005/d0026001_giftVictoryLine.mp3"},{"skin":"D0026001","type":"giftLoseLine","order":41,"label":"感应2","text":"这些记录整齐排列在一起，就像田地里的玉米。","key":"voice/d0026/1005/d0026001_giftLoseLine.mp3"},{"skin":"D0026001","type":"teaVictoryLine","order":42,"label":"品茗1","text":"感觉就像阳光普照之下，作物舒展了它的叶子，迎风摇曳。","key":"voice/d0026/1005/d0026001_teaVictoryLine.mp3"},{"skin":"D0026001","type":"teaLoseLine","order":43,"label":"品茗2","text":"陌生的香气，听说人们对茶的喜爱不亚于可可，我想一探究竟。","key":"voice/d0026/1005/d0026001_teaLoseLine.mp3"},{"skin":"D0026001","type":"happyBirthdayLine","order":44,"label":"生日庆贺","text":"在你诞生的日子，今夜的星星为你而闪耀。","key":"voice/d0026/1005/d0026001_happyBirthdayLine.mp3"}]},{"lang":"1001","name":"中文-普通话","cv":"山岸","lines":[{"skin":"D0026001","type":"dropLine","order":1,"label":"招集","text":"太阳依旧升起，你好，我是玛雅文字陶碗。","key":"voice/d0026/1001/d0026001_dropLine.mp3"},{"skin":"D0026001","type":"regardsLine","order":2,"label":"问候","text":"可可是货币，是食物，也可以是礼物。","key":"voice/d0026/1001/d0026001_regardsLine.mp3"},{"skin":"D0026001","type":"appointmentLine","order":3,"label":"任命","text":"我更擅长耕种和雕刻的活动，不过，我会听你的话试试。","key":"voice/d0026/1001/d0026001_appointmentLine.mp3"},{"skin":"D0026001","type":"touchLine_1","order":4,"label":"交谈1","text":"我在回想已经不复存在的田地，族人和我的家，再也没有人像那样交谈天气和作物，他们已经走向黑夜。","key":"voice/d0026/1001/d0026001_touchLine_1.mp3"},{"skin":"D0026001","type":"touchLine_2","order":5,"label":"交谈2","text":"在我们的祈祷下，羽蛇神腾空而起，飞越高高的树梢，在天空中翱翔，它带来闪电与雨水，新的季节到来了，作物生长。","key":"voice/d0026/1001/d0026001_touchLine_2.mp3"},{"skin":"D0026001","type":"touchLin