_015_221"}},"30411":{"tags":["宿卫","近战"],"series":9,"grades":[{"hp":440,"atk":160},{"hp":706,"atk":249},{"hp":972,"atk":338},{"hp":1503,"atk":515}],"grow":{"hp":18,"atk":6},"file":{"type":"设计装备","class":"仿真类·盾","trait":"器者力学/抗击卸力","maker":"巫南研究·宿卫","text":"秉持经典，尊重国粹，该装备诞生自某个彻夜不眠、哗啦啦声阵阵的夜晚之后。\n\n不同地区的麻将有不同的花色，东南西北坐镇四方，为下一把的手气增光添彩。\n\n每位麻将爱好者都有权购买制造图纸的商业授权。","weight":"18.5KG","batch":"RS_015_222"}},"30412":{"tags":["轻锐","近战"],"series":9,"grades":[{"hp":400,"atk":176},{"hp":636,"atk":265},{"hp":872,"atk":354},{"hp":1344,"atk":531}],"grow":{"hp":16,"atk":6},"file":{"type":"设计装备","class":"仿真类·剑","trait":"强度材料/减负元件","maker":"巫南研究·轻锐","text":"秉持经典，尊重国粹，该装备诞生自某个彻夜不眠、哗啦啦声阵阵的夜晚之后。\n\n虽然明知凑出这种花色对于赢牌没有任何帮助，但是设计师坚持认为这赏心悦目，值得作为剑器展示出来。\n\n每位麻将爱好者都有权购买制造图纸的商业授权。","weight":"2.2KG","batch":"RS_015_222"}},"30413":{"tags":["远击","远程","输出"],"series":9,"grades":[{"hp":380,"atk":184},{"hp":602,"atk":273},{"hp":824,"atk":362},{"hp":1267,"atk":539}],"grow":{"hp":15,"atk":6},"file":{"type":"模拟装备","class":"仿真类·弓弩","trait":"轻量级/灵活便携","maker":"巫南研究·远击","text":"秉持经典，尊重国粹，该装备诞生自某个彻夜不眠、哗啦啦声阵阵的夜晚之后。\n\n又名清一色复合弩，纪念一次难忘的胜利。\n\n每位麻将爱好者都有权购买制造图纸的商业授权。","weight":"2.8KG","batch":"RS_015_120"}},"30414":{"tags":["构术","远程"],"series":9,"grades":[{"hp":360,"atk":192},{"hp":567,"atk":296},{"hp":774,"atk":400},{"hp":1187,"atk":607}],"grow":{"hp":14,"atk":7},"file":{"type":"设计装备","class":"仿真类·法杖","trait":"强隐蔽/严密分子层","maker":"巫南研究·构术","text":"秉持经典，尊重国粹，该装备诞生自某个彻夜不眠、哗啦啦声阵阵的夜晚之后。\n\n麻将牌花色迥然缠绕悬仪，经典排布从古至今，取下小小一颗麻将即可作为炮弹发射。注：普通麻将不能作为炮弹，还请不要尝试。\n\n每位麻将爱好者都有权购买制造图纸的商业使用授权。","weight":"6.0KG","batch":"RS_015_222"}},"30415":{"tags":["战略","远程"],"series":9,"grades":[{"hp":340,"atk":200},{"hp":547,"atk":304},{"hp":754,"atk":408},{"hp":1167,"atk":615}],"grow":{"hp":14,"atk":7},"file":{"type":"设计装备","class":"仿真类·炮","trait":"夜视调节/短距重炮","maker":"巫南研究·战略","text":"秉持经典，尊重国粹，该装备诞生自某个彻夜不眠、哗啦啦声阵阵的夜晚之后。\n\n筒子花色圆润大方，置于短炮上更添一份“今晚再搓一把”的冲动……只要别在战斗的时候突然跑去打麻将，应该也没问题。\n\n每位麻将爱好者都有权购买制造图纸的商业授权。","weight":"22.5KG","batch":"RS_015_222"}},"30421":{"tags":["宿卫","近战"],"series":9,"grades":[{"hp":550,"atk":200},{"hp":875,"atk":304},{"hp":1200,"atk":408},{"hp":1849,"atk":615}],"grow":{"hp":22,"atk":7},"file":{"type":"设计装备","class":"仿真类·盾","trait":"器者力学/抗击卸力","maker":"海角山庄·宿卫","text":"秉持经典，尊重国粹，该装备诞生自某个彻夜不眠、哗啦啦声阵阵的夜晚之后。\n\n不同地区的麻将有不同的花色，东南西北坐镇四方，为下一把的手气增光添彩。\n\n每位麻将爱好者都有权购买制造图纸的商业授权。","weight":"18.5KG","batch":"RS_015_222"}},"30422":{"tags":["轻锐","近战"],"series":9,"grades":[{"hp":500,"atk":220},{"hp":795,"atk":338},{"hp":1090,"atk":456},{"hp":1680,"atk":692}],"grow":{"hp":20,"atk":8},"file":{"type":"设计装备","class":"仿真类·剑","trait":"强度材料/减负元件","maker":"海角山庄·轻锐","text":"秉持经典，尊重国粹，该装备诞生自某个彻夜不眠、哗啦啦声阵阵的夜晚之后。\n\n虽然明知凑出这种花色对于赢牌没有任何帮助，但是设计师坚持认为这赏心悦目，值得作为剑器展示出来。\n\n每位麻将爱好者都有权购买制造图纸的商业授权。","weight":"2.2KG","batch":"RS_015_222"}},"30423":{"tags":["远击","远程","输出"],"series":9,"grades":[{"hp":475,"atk":230},{"hp":756,"atk":348},{"hp":1037,"atk":466},{"hp":1598,"atk":702}],"grow":{"hp":19,"atk":8},"file":{"type":"模拟装备","class":"仿真类·弓弩","trait":"轻量级/灵活便携","maker":"海角山庄·远击","text":"秉持经典，尊重国粹，该装备诞生自某个彻夜不眠、哗啦啦声阵阵的夜晚之后。\n\n又名清一色复合弩，纪念一次难忘的胜利。\n\n每位麻将爱好者都有权购买制造图纸的商业授权。","weight":"2.8KG","batch":"RS_015_120"}},"30424":{"tags":["构术","远程"],"series":9,"grades":[{"hp":450,"atk":240},{"hp":716,"atk":358},{"hp":982,"atk":476},{"hp":1513,"atk":712}],"grow":{"hp":18,"atk":8},"file":{"type":"设计装备","class":"仿真类·法杖","trait":"强隐蔽/严密分子层","maker":"海角山庄·构术","text":"秉持经典，尊重国粹，该装备诞生自某个彻夜不眠、哗啦啦声阵阵的夜晚之后。\n\n麻将牌花色迥然缠绕悬仪，经典排布从古至今，取下小小一颗麻将即可作为炮弹发射。注：普通麻将不能作为炮弹，还请不要尝试。\n\n每位麻将爱好者都有权购买制造图纸的商业使用授权。","weight":"6.0KG","batch":"RS_015_222"}},"30425":{"tags":["战略","远程"],"series":9,"grades":[{"hp":425,"atk":250},{"hp":676,"atk":383},{"hp":927,"atk":516},{"hp":1429,"atk":782}],"grow":{"hp":17,"atk":9},"file":{"type":"设计装备","class":"仿真类·炮","trait":"夜视调节/短距重炮","maker":"海角山庄·战略","text":"秉持经典，尊重国粹，该装备诞生自某个彻夜不眠、哗啦啦声阵阵的夜晚之后。\n\n筒子花色圆润大方，置于短炮上更添一份“今晚再搓一把”的冲动……只要别在战斗的时候突然跑去打麻将，应该也没问题。\n\n每位麻将爱好者都有权购买制造图纸的商业授权。","weight":"22.5KG","batch":"RS_015_222"}},"30521":{"tags":["宿卫","近战"],"series":11,"grades":[{"hp":550,"atk":200},{"hp":875,"atk":304},{"hp":1200,"atk":408},{"hp":1849,"atk":615}],"grow":{"hp":22,"atk":7},"file":{"type":"概念装备","class":"铜青类·盾","trait":"仿青铜/严密分子层","maker":"琢磨·宿卫","text":"概念性装备，锤走偏锋，悬鼻獠牙，诡谲古拙。\n\n在实验阶段，该装备的造型让部分器者产生了强烈的情绪，于四川地区使用时请多加小心。\n\n获取该装备制造图纸需较高权限。","weight":"8.3KG","batch":"T_2615_116"}},"30522":{"tags":["轻锐","近战","爆发"],"series":11,"grades":[{"hp":500,"atk":220},{"hp":795,"atk":338},{"hp":1090,"atk":456},{"hp":1680,"atk":692}],"grow":{"hp":20,"atk":8},"file":{"type":"概念装备","class":"铜青类·双刀","trait":"青铜烧刃/自动化","maker":"琢磨·轻锐","text":"高级匠师精心设计，现代半自动化刀柄为基，特制概念性铜青材料为身，宣称大巧若拙。\n\n刀身上活灵活现、栩栩如生的龙，仿佛正要吞噬敌人——另有发光限量版限时售卖！\n\n装备制造图纸已对各工作室开放。","weight":"1.5KG","batch":"RS_3331_119"}},"30523":{"tags":["远击","远程","输出"],"series":11,"grades":[{"hp":475,"atk":230},{"hp":756,"atk":348},{"hp":1037,"atk":466},{"hp":1598,"atk":702}],"grow":{"hp":19,"atk":8},"file":{"type":"模拟装备","class":"铜青类·弓弩","trait":"视差调节/轻量级","maker":"琢磨·远击","text":"山影重重，磐钟阵阵，掠过十万里大山之影，飞鸟游鱼皆在箭下。\n\n“再次重申，敲击两边的编钟会缩短装备的使用寿命，请勿随意敲击。”\n\n获取该装备制造授权需达到一定保密等级。","weight":"2.8KG","batch":"T_2615_122"}},"30524":{"tags":["构术","远程","增益"],"series":11,"grades":[{"hp":450,"atk":240},{"hp":716,"atk":358},{"hp":982,"atk":476},{"hp":1513,"atk":712}],"grow":{"hp":18,"atk":8},"file":{"type":"模拟装备","class":"铜青类·法杖","trait":"态势感知/硬化合金","maker":"琢磨·构术","text":"香炉，紫烟，日照之下，典雅之器缄默不语，生命气息于炉中脉脉流传。\n\n注：烟雾为模拟虚景，可以放心在烟雾报警器下使用。\n\n现已公开制造图纸。","weight":"7.5KG","batch":"T_2615_117"}},"30525":{"tags":["战略","远程"],"series":11,"grades":[{"hp":425,"atk":250},{"hp":676,"atk":383},{"hp":927,"atk":516},{"hp":1429,"atk":782}],"grow":{"hp":17,"atk":9},"file":{"type":"概念装备","class":"铜青类·炮","trait":"控温装置/力度调节","maker":"琢磨·战略","text":"创新之作，摒弃瑰丽珠宝，回归朴素青铜，以润泽金属诠释危险炮火。该装备使用特殊的燃料驱动，可以有效使敌方晕厥。\n\n注意：可能烫手。\n\n获取装备制造授权需要一定珠宝。","weight":"5.0KG","batch":"RS_2615_118"}},"30621":{"tags":["宿卫","近战"],"series":12,"grades":[{"hp":550,"atk":200},{"hp":875,"atk":304},{"hp":1200,"atk":408},{"hp":1849,"atk":615}],"grow":{"hp":22,"atk":7},"file":{"type":"模拟装备","class":"仿真类·盾","trait":"强隐蔽/严密分子层","maker":"海角山庄·宿卫","text":"战马，王与后，Checkmate，严谨产出，试图寓教于乐，但效果未知。\n\n实用性和战斗性的完美结合，但请注意不要在战场上掉落棋子，以免对敌人造成嘲讽。\n\n装备制造图纸已对各工作室开放。","weight":"7.3KG","batch":"T_2615_117"}},"30622":{"tags":["轻锐","近战"],"series":12,"grades":[{"hp":500,"atk":220},{"hp":795,"atk":338},{"hp":1090,"atk":456},{"hp":1680,"atk":692}],"grow":{"hp":20,"atk":8},"file":{"type":"测试装备","class":"仿真类·剑","trait":"高密度/高强度","maker":"海角山庄·轻锐","text":"五子连珠方为胜利。五子棋规则简单，上至八十岁老人，下至三岁孩童皆可同台竞技，棋盘上尔虞我诈、你下我堵，在即将失败之际，如何挽回颓势？用这把剑直接划破棋盘吧！\n\n——设计师在连续输给某器者十次之后，愤而设计的一把装备。显而易见，在下棋时，他执的是黑子。\n\n装备制造图纸对内公开。","weight":"2.0KG","batch":"RS_015_222"}},"30623":{"tags":["远击","远程"],"series":12,"grades":[{"hp":475,"atk":230},{"hp":756,"atk":348},{"hp":1037,"atk":466},{"hp":1598,"atk":702}],"grow":{"hp":19,"atk":8},"file":{"type":"设计装备","class":"仿真类·弓弩","trait":"仿真设计/模型解构","maker":"海角山庄·远击","text":"春夏秋冬，梅兰竹菊，四时之景，四季之花，尽于牌面弩间。贴近生活的极简造型，简便易上手的装备使用，保证每一位远击器者能体会到花牌的魅力和攻击的简易。\n\n……但是怎么这么重，难道设计师往里面掺杂了高强度材料？\n\n装备制造图纸对内公开。","weight":"8.5KG","batch":"RS_015_222"}},"30624":{"tags":["构术","远程"],"series":12,"grades":[{"hp":450,"atk":240},{"hp":716,"atk":358},{"hp":982,"atk":476},{"hp":1513,"atk":712}],"grow":{"hp":18,"atk":8},"file":{"type":"测试装备","class":"仿真类·法杖","trait":"离子重塑/模型解构","maker":"海角山庄·构术","text":"仪身圆润晶莹，高强度重组玻璃材质，在阳光下流光溢彩。跳棋棋盘对称设计，不同组合可以拼成不同类型的棋盘，必要时候还可以作为桌游桌面使用，请尽情探索。\n\n战场潜伏小秘诀：随身带一把跳棋，就能在埋伏敌人的时候跟战友来两把，打发无聊的时光。\n\n装备制造图纸对内公开。","weight":"8.7KG","batch":"RS_015_222"}},"30625":{"tags":["战略","远程"],"series":12,"grades":[{"hp":425,"atk":250},{"hp":676,"atk":383},{"hp":927,"atk":516},{"hp":1429,"atk":782}],"grow":{"hp":17,"atk":9},"file":{"type":"测试装备","class":"仿真类·炮","trait":"离子重塑/模型解构","maker":"海角山庄·战略","text":"依次摸牌，以大抓小。叶子戏辅以骰子，每次投掷都精准落到“六”点，人工保障使用者的幸运。纸牌之下，是一颗飞速推演计算的心。\n\n但在扔骰子比大小时禁止使用该装备中的骰子，作弊不好，作弊不好。\n\n装备制造图纸对内公开。","weight":"6.5KG","batch":"RS_015_121"}},"30741":{"tags":["宿卫","近战","防御"],"series":2,"grades":[{"hp":660,"atk":240},{"hp":1044,"atk":358},{"hp":1428,"atk":476},{"hp":2195,"atk":712}],"grow":{"hp":26,"atk":8},"file":{"type":"概念装备","class":"珐琅类·盾","trait":"态势感知/硬化合金","maker":"超金·宿卫","text":"仿珐琅材质，光滑无暇，喜气洋洋。圆润线条昭示柔和，摇铃装备尽显童趣。\n\n一挡毫发无伤，二挡人生无忧，三挡寿比南山。除了不适合给老人家祝寿以外，一切都很完美。\n\n装备制造图纸对内公开。","weight":"15.3KG","batch":"RS_3991_39"}},"30742":{"tags":["轻锐","近战","突进"],"series":2,"grades":[{"hp":600,"atk":264},{"hp":954,"atk":397},{"hp":1308,"atk":530},{"hp":2016,"atk":796}],"grow":{"hp":24,"atk":9},"file":{"type":"制式装备","class":"珐琅类·钩","trait":"特种装备/专攻轻甲","maker":"超金·轻锐","text":"仿珐琅材质，装备前端回扣成险恶勾状，钩柄雕有金鸡之首，锋利之势处处可见。\n\n……但比起攻击敌人，更经常被用来勾树枝。\n\n装备制造图纸对内公开。","weight":"5.3KG","batch":"T_2615_116"}},"30743":{"tags":["远击","远程","伤害增强"],"series":2,"grades":[{"hp":570,"atk":276},{"hp":910,"atk":424},{"hp":1250,"atk":572},{"hp":1929,"atk":867}],"grow":{"hp":23,"atk":10},"file":{"type":"概念装备","class":"珐琅类·弓弩","trait":"配件可拆/简易便携/减震优异","maker":"超金·远击","text":"走遍千山万水，拍摄日升日落，于天鸡鸣叫声中迎接崭新一天，顿悟人生——\n\n这一箭，射出的不是鸡鸣，而是荣华富贵利禄之心。\n\n装备制造图纸对内公开。","weight":"2.3KG","batch":"RS_2615_118"}},"30744":{"tags":["构术","远程"],"series":2,"grades":[{"hp":540,"atk":288},{"hp":865,"atk":436},{"hp":1190,"atk":584},{"hp":1839,"atk":879}],"grow":{"hp":22,"atk":10},"file":{"type":"概念装备","class":"珐琅类·法杖","trait":"重型炮弹/电弧内导","maker":"超金·构术","text":"吉祥如意迎喜事，威风凛凛退来敌。兼备招猫逗狗哄小孩等多种功能，使用时记得关闭攻击按钮。\n\n内附设计理念：“人们一刻不停地在道路上奔波，唯独过年时会停下脚步，环顾周围，在热闹的红色中欢度。我觉得，出于人文关怀，敌人也该在被打的时候体验一下我们的传统文化……“\n\n装备制造图纸对内公开。","weight":"5.0KG","batch":"RS_3991_39"}},"30745":{"tags":["战略","远程"],"series":2,"grades":[{"hp":510,"atk":300},{"hp":805,"atk":463},{"hp":1100,"atk":626},{"hp":1690,"atk":951}],"grow":{"hp":20,"atk":11},"file":{"type":"测试装备","class":"珐琅类·炮","trait":"防腐涂层/多地形适应","maker":"超金·战略","text":"杀伤力固然重要，精神内涵也不必可少。此装备兼具两种特色，请收下这一击行星毁灭级真诚祝福，祝各位阖家欢乐，新年财气旺……\n\n我开玩笑的别拿这个对着人啊！\n\n装备制造图纸对内公开，其他机构请记得在说明书里备注：不要拿这种装备对着人。","weight":"19.0KG","batch":"T_2615_122"}},"30841":{"tags":["宿卫","近战"],"series":6,"grades":[{"hp":660,"atk":240},{"hp":1044,"atk":358},{"hp":1428,"atk":476},{"hp":2195,"atk":712}],"grow":{"hp":26,"atk":8},"file":{"type":"古典装备","class":"古典类·盾","trait":"器者力学/双倍减负","maker":"鸠浅·宿卫","text":"“狴犴好讼，亦曰宪章。”以狴犴镇压奸妄，以正义抵挡敌人。持此沉重铜盾，坚定向前，排除一切扰乱内心的话语，堡垒般绝不后退。\n\n\"呃，是不是有点沉……设计师多包装一下，看看能不能把这种沉重转化为装备的特色！“\n\n全系列制造图纸对内部公开。","weight":"10.0KG","batch":"RS_3991_39"}},"30842":{"tags":["轻锐","近战"],"series":6,"grades":[{"hp":600,"atk":264},{"hp":954,"atk":397},{"hp":1308,"atk":530},{"hp":2016,"atk":796}],"grow":{"hp":24,"atk":9},"file":{"type":"古典装备","class":"古典类·剑","trait":"复合金属/多地形适应","maker":"鸠浅·轻锐","text":"“狴犴好讼，亦曰宪章。”以狴犴为剑，剑指混沌纷杂的乱世，刀光剑影背后，是一派河清海晏。\n\n前行路漫漫，唯望神兽纹饰能为你带来几分护佑。\n\n全系列制造图纸对内部公开。","weight":"11.0KG","batch":"RS_3991_39"}},"30843":{"tags":["远击","远程"],"series":6,"grades":[{"hp":570,"atk":276},{"hp":910,"atk":424},{"hp":1250,"atk":572},{"hp":1929,"atk":867}],"grow":{"hp":23,"atk":10},"file":{"type":"概念装备","class":"古典类·弓弩","trait":"反器材弓弩/重型弩箭","maker":"鸠浅·远击","text":"龙生九子，各不相同。狴犴，乃龙之第七子，狱门之守、百姓之护。以此兽为弩，可保卫一方太平。\n\n注：该弩后坐力极强，建议谨慎使用。\n\n装备制造图纸对内公开。","weight":"10.0KG","batch":"T_2615_117"}},"30844":{"tags":["构术","远程"],"series":6,"grades":[{"hp":540,"atk":288},{"hp":865,"atk":436},{"hp":1190,"atk":584},{"hp":1839,"atk":879}],"grow":{"hp":22,"atk":10},"file":{"type":"古典装备","class":"古典类·法杖","trait":"磁悬浮/多地形适应","maker":"鸠浅·构术","text":"“狴犴好讼，亦曰宪章。”仪器悬浮于手，如一颗心脏，时时刻刻鼓动不停，为公平公正的脉搏输送血液。\n\n我们捍卫文明，也捍卫文明之中哪怕最微不足道的公平。\n\n全系列制造图纸对内部公开。","weight":"22.0KG","batch":"RS_3991_39"}},"30845":{"tags":["战略","远程"],"series":6,"grades":[{"hp":510,"atk":300},{"hp":805,"atk":463},{"hp":1100,"atk":626},{"hp":1690,"atk":951}],"grow":{"hp":20,"atk":11},"file":{"type":"古典装备","class":"古典类·炮","trait":"构势能/缓冲后座","maker":"鸠浅·战略","text":"“狴犴好讼，亦曰宪章。”以狴犴为炮，轰出最激烈的镀铜炮弹，让狴犴形状的爆炸云升腾在保卫平安的战场上。\n\n刻刀悉心篆刻，麒麟的主人将期许融入装备之中。\n\n全系列制造图纸对内部公开。","weight":"16.3KG","batch":"RS_3991_39"}},"30941":{"tags":["宿卫","近战"],"series":5,"grades":[{"hp":660,"atk":240},{"hp":1044,"atk":358},{"hp":1428,"atk":476},{"hp":2195,"atk":712}],"grow":{"hp":26,"atk":8},"file":{"type":"古典装备","class":"古典类·盾","trait":"态势感知/硬化合金","maker":"超金·宿卫","text":"树枝清雅，花苞微绽，暮光悠悠。鸟儿在画中展翅，形意逼真，尽显活泼……本来只是一幅画，被设计师征用拿来印在盾牌上，还用科技骨架裱了起来。防御力？应该很高吧……\n\n如果想挂在家中墙壁上进行展览，请务必多钉几颗悬挂钉，否则墙壁难以承重。\n\n现已公开制造图纸，做画或者做装备都可以。","weight":"30.0KG","batch":"T_2615_151"}},"30942":{"tags":["轻锐","近战"],"series":5,"grades":[{"hp":600,"atk":264},{"hp":954,"atk":397},{"hp":1308,"atk":530},{"hp":2016,"atk":796}],"grow":{"hp":24,"atk":9},"file":{"type":"古典装备","class":"古典类·刀","trait":"态势感知/硬化合金","maker":"超金·轻锐","text":"“山回路转不见君”。青山绿水尽镶于玲珑刀柄，精选美工刀制式进行设计，古画与现代简便器具两相结合，一份猜不透的作品。\n\n是的，这把装备真的可以当美工刀用，它附加有缩小功能，裁纸轻松自如，甚至可以用来切水果。\n\n现已公开制造图纸，做美工刀或者做装备都可以。","weight":"8.2KG","batch":"T_2615_151"}},"30943":{"tags":["远击","远程"],"series":5,"grades":[{"hp":570,"atk":276},{"hp":910,"atk":424},{"hp":1250,"atk":572},{"hp":1929,"atk":867}],"grow":{"hp":23,"atk":10},"file":{"type":"古典装备","class":"古典类·弓弩","trait":"高倍瞄准/强度材料","maker":"超金·远击","text":"青松蓊郁，山水匆匆，人行其间，天地几何？折扇折住风流，扇去清风……当见幽堂的画家无意间看到这把装备时，喃喃自语：“看来设计师是一次性把这一系列的扇子设计图都拿走了。”\n\n特意装载风向监控装置，为每一次射击的准确性保驾护航。\n\n现已公开制造图纸，做扇子或者做装备都可以。","weight":"11.2KG","batch":"T_2615_151"}},"30944":{"tags":["构术","远程","爆发"],"series":5,"grades":[{"hp":540,"atk":288},{"hp":865,"atk":436},{"hp":1190,"atk":584},{"hp":1839,"atk":879}],"grow":{"hp":22,"atk":10},"file":{"type":"意外惊喜","class":"古典类·法杖","trait":"攻击/避暑/双开模式","maker":"超金·构术","text":"“唯有牡丹真国色”。原本是一份普通的蒲扇设计稿，却意外被装备设计师拿走，不久后的新型装备测试中便出现了它……设计师，你不要再到处乱拿了！\n\n但是，只要不嫌重，您也可以拿来扇风。记得脸往后仰，别划到脸。\n\n现已公开制造图纸，做扇子或者做装备都可以。","weight":"2.9KG","batch":"T_2615_115"}},"30945":{"tags":["战略","远程"],"series":5,"grades":[{"hp":510,"atk":300},{"hp":805,"atk":463},{"hp":1100,"atk":626},{"hp":1690,"atk":951}],"grow":{"hp":20,"atk":11},"file":{"type":"古典装备","class":"古典类·炮","trait":"构势能/缓冲后座","maker":"超金·战略","text":"“桃花流水窅然去，别有天地非人间”。黄山之奇，独一无二。原本是作为元宵节的花灯设计，设计师的确也往里面安装了灯管，虽然是拿来聚能射击而不是照亮的……\n\n据说也可以当做花灯使用，只要将安全栓关好。但是真的会有人拿去照明吗？\n\n现已公开制造图纸，做扇子或者做装备都可以。","weight":"8.4KG","batch":"T_2615_151"}},"31041":{"tags":["宿卫","近战"],"series":4,"grades":[{"hp":660,"atk":240},{"hp":1044,"atk":358},{"hp":1428,"atk":476},{"hp":2195,"