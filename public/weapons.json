476},{"hp":2195,"atk":712}],"grow":{"hp":26,"atk":8},"file":{"type":"概念装备","class":"绮木覆花·盾","trait":"特殊材质/多功能","maker":"罄乐行·宿卫","text":"画中所绘，乃有一山。山有乔木，聚树成林，其下有花，绕树而上。说时迟那时快，武器设计师同僚心有所感，遂返回工作处，设计出此套装备。\n生灵之意，庇佑吾身。\n设计图纸对内部开放。","weight":"10kg","batch":"D_7656_005"}},"31542":{"tags":["轻锐","近战"],"series":16,"grades":[{"hp":600,"atk":264},{"hp":954,"atk":397},{"hp":1308,"atk":530},{"hp":2016,"atk":796}],"grow":{"hp":24,"atk":9},"file":{"type":"概念装备","class":"绮木覆花·剑","trait":"特殊材质/便携美观","maker":"罄乐行·轻锐","text":"画中所绘，乃有一山。山有乔木，聚树成林，其下有花，绕树而上。说时迟那时快，武器设计师同僚心有所感，遂返回工作处，设计出此套装备。\n山重水复，剑指出路。\n设计图纸对内部开放。","weight":"3.5kg","batch":"D_7656_003"}},"31543":{"tags":["远击","远程"],"series":16,"grades":[{"hp":570,"atk":276},{"hp":910,"atk":424},{"hp":1250,"atk":572},{"hp":1929,"atk":867}],"grow":{"hp":23,"atk":10},"file":{"type":"概念装备","class":"绮木覆花·弩","trait":"特殊材质/力度调节","maker":"罄乐行·远击","text":"画中所绘，乃有一山。山有乔木，聚树成林，其下有花，绕树而上。说时迟那时快，武器设计师同僚心有所感，遂返回工作处，设计出此套装备。\n花木相随，静心瞄准。\n设计图纸对内部开放。","weight":"4kg","batch":"D_7656_002"}},"31544":{"tags":["构术","远程"],"series":16,"grades":[{"hp":540,"atk":288},{"hp":865,"atk":436},{"hp":1190,"atk":584},{"hp":1839,"atk":879}],"grow":{"hp":22,"atk":10},"file":{"type":"概念装备","class":"绮木覆花·仪","trait":"特殊材质/精加工","maker":"罄乐行·构术","text":"画中所绘，乃有一山。山有乔木，聚树成林，其下有花，绕树而上。说时迟那时快，武器设计师同僚心有所感，遂返回工作处，设计出此套装备。\n灵植于手，观尽世事。\n设计图纸对内部开放。","weight":"5kg","batch":"D_7656_001"}},"31545":{"tags":["战略","远程"],"series":16,"grades":[{"hp":510,"atk":300},{"hp":805,"atk":463},{"hp":1100,"atk":626},{"hp":1690,"atk":951}],"grow":{"hp":20,"atk":11},"file":{"type":"概念装备","class":"绮木覆花·炮","trait":"特殊材质/结构调整","maker":"罄乐行·战略","text":"画中所绘，乃有一山。山有乔木，聚树成林，其下有花，绕树而上。说时迟那时快，武器设计师同僚心有所感，遂返回工作处，设计出此套装备。\n绚丽山木，映人愿景。\n设计图纸对内部开放。","weight":"9kg","batch":"D_7656_004"}},"39001":{"tags":["轻锐","近战","突进"],"series":3,"grades":[{"hp":600,"atk":264},{"hp":954,"atk":397},{"hp":1308,"atk":530},{"hp":2016,"atk":796}],"grow":{"hp":24,"atk":9},"file":{"type":"概念装备","class":"仿真类·剑","trait":"多功能/自动化","maker":"鸠浅·轻锐","text":"越王勾践剑身为顾问时设计的装备，充分结合名剑之特征，刀锋炽热，削铁如泥。\n\n“这个挺不错啊，特殊情况还能应急……什么！刀币不流通了？那能不能做现代货币的……”\n“做假币犯法！”\n\n已无偿公开制造图纸。","weight":"4.0KG","batch":"RS_2615_118"}},"39002":{"tags":["远击","远程"],"series":3,"grades":[{"hp":570,"atk":276},{"hp":910,"atk":424},{"hp":1250,"atk":572},{"hp":1929,"atk":867}],"grow":{"hp":23,"atk":10},"file":{"type":"模拟装备","class":"古典类·弓弩","trait":"构势能/缓冲后座","maker":"鸠浅·远击","text":"爆炸中意外研究出带有松木清香的高硬度涂料，辅以精心设计的木雕部件，以上两者结合而成的装备，能让怀旧的器者充满安心的感觉，因此大受好评。\n\n另搭配金乌贴纸，可自行装饰在弩箭上，但——“不是说随便有把弓就能射日，别拿瞄准镜对着太阳啊，眼睛还要不要了！”\n\n已授权给多个设计师。","weight":"1.8KG","batch":"RS_3991_39"}},"39004":{"tags":["宿卫","近战","自我恢复"],"series":3,"grades":[{"hp":660,"atk":240},{"hp":1044,"atk":358},{"hp":1428,"atk":476},{"hp":2195,"atk":712}],"grow":{"hp":26,"atk":8},"file":{"type":"模拟装备","class":"仿真类·盾","trait":"硬化合金/磁悬浮","maker":"鸠浅·宿卫","text":"以“帅”为击器，以棋盘为盾牌，楚河汉界横跨盾面，阻挡敌人不可越界……\n\n原本以为是这样的意图，但设计师表示：“车前卒，马后炮！中国象棋防爆盾，战场上抵御攻击，战场下就地摆放品味国粹，好耶！”\n\n获取授权需要跟设计师下一盘象棋。","weight":"10.3KG","batch":"RS_015_120"}},"39006":{"tags":["构术","远程","增益"],"series":3,"grades":[{"hp":540,"atk":288},{"hp":865,"atk":436},{"hp":1190,"atk":584},{"hp":1839,"atk":879}],"grow":{"hp":22,"atk":10},"file":{"type":"星象装备","class":"星象类·法杖","trait":"磁悬浮/多地形适应","maker":"鸠浅·构术","text":"拥有异常力量的黑色晶体，整体如晚霞般绚丽而低调，易于携带，威力巨大。\n\n——三垣，四象，二十八星宿，天空神秘不可测，宇宙遥不可及，而我们试图从中窥得超脱肉体的真理。\n\n装备制造图纸对内公开。","weight":"7.5KG","batch":"RS_015_120"}},"39007":{"tags":["战略","远程","输出"],"series":3,"grades":[{"hp":510,"atk":300},{"hp":805,"atk":463},{"hp":1100,"atk":626},{"hp":1690,"atk":951}],"grow":{"hp":20,"atk":11},"file":{"type":"概念装备","class":"仿真类·炮","trait":"特制银涂/隐蔽绝佳","maker":"鸠浅·战略","text":"由佚名器者设计。银色导能物质组成复杂的图案，美丽的外表下有致命的杀伤力。炎热地带水分稀缺，令人禁不住遐想美好：好想吃冰淇淋。\n\n注：雪绒花同样意味着对和平的向往，设计师虽只字未提，但装备是否蕴藏着这般深意，我们仍在猜测。\n\n装备制造图纸对内公开。","weight":"12.9KG","batch":"T_2615_139"}}}}