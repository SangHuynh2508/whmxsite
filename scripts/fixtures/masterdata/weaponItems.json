 },
 {
  "id": "30411",
  "type": 9,
  "rare": 3,
  "nameLanText": "麻雀牌盾",
  "DescriptionLanText": "器者装备。\n不同地区的麻将有不同的花色，东南西北坐镇四方，为下一把的手气增光添彩。"
 },
 {
  "id": "30412",
  "type": 9,
  "rare": 3,
  "nameLanText": "麻雀牌剑",
  "DescriptionLanText": "器者装备。\n虽然明知凑出这种花色对于赢牌没有任何帮助，但是设计师坚持认为这赏心悦目，值得作为剑器展示出来。"
 },
 {
  "id": "30413",
  "type": 9,
  "rare": 3,
  "nameLanText": "麻雀牌弩",
  "DescriptionLanText": "器者装备。\n又名清一色复合弩，纪念一次难忘的胜利。"
 },
 {
  "id": "30414",
  "type": 9,
  "rare": 3,
  "nameLanText": "麻雀牌悬仪",
  "DescriptionLanText": "器者装备。\n麻将牌花色迥然缠绕悬仪，经典排布从古至今，取下小小一颗麻将即可作为炮弹发射。注：麻将不能作为炮弹，请不要尝试。"
 },
 {
  "id": "30415",
  "type": 9,
  "rare": 3,
  "nameLanText": "麻雀牌炮",
  "DescriptionLanText": "器者装备。\n筒子花色圆润大方，置于短炮上更添一份“今晚再搓一把”的冲动……只要别在战斗的时候突然跑去打麻将，应该也没问题。"
 },
 {
  "id": "30421",
  "type": 9,
  "rare": 4,
  "nameLanText": "麻雀牌盾",
  "DescriptionLanText": "器者装备。\n不同地区的麻将有不同的花色，东南西北坐镇四方，为下一把的手气增光添彩。"
 },
 {
  "id": "30422",
  "type": 9,
  "rare": 4,
  "nameLanText": "麻雀牌剑",
  "DescriptionLanText": "器者装备。\n虽然明知凑出这种花色对于赢牌没有任何帮助，但是设计师坚持认为这赏心悦目，值得作为剑器展示出来。"
 },
 {
