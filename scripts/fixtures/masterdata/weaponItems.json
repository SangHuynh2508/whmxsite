[
 {
  "id": "30111",
  "type": 9,
  "rare": 3,
  "nameLanText": "路边物件盾",
  "DescriptionLanText": "器者装备。\n外出时得到的灵感，设计者本来想使用“修自行车”的字样，被同僚制止了。"
 },
 {
  "id": "30112",
  "type": 9,
  "rare": 3,
  "nameLanText": "路边禁行刀",
  "DescriptionLanText": "器者装备。\n仿真设计，紧急事态下可以直接放置在平地上当禁止标识，但平时请勿乱拿乱放，以免影响正常非机动车行驶。"
 },
 {
  "id": "30113",
  "type": 9,
  "rare": 3,
  "nameLanText": "路障弩",
  "DescriptionLanText": "器者装备。\n抽象工业设计，将路障一分为二再度组合，配色中设计充满了设计师的随意和天马行空。"
 },
 {
  "id": "30114",
  "type": 9,
  "rare": 3,
  "nameLanText": "夜芒灯",
  "DescriptionLanText": "器者装备。\n为不会使用电器的器者提供全新的选择。您夜晚归家路上的好伙伴。"
 },
 {
  "id": "30115",
  "type": 9,
  "rare": 3,
  "nameLanText": "路边物件炮",
  "DescriptionLanText": "器者装备。\n曾被外部人士误用，可喷出的不是消防泡沫，是炮火——经过沉重的教训，现已添加灭火功能，请阅读说明书进行模式切换。"
 },
 {
