 },
 {
  "id": "30301",
  "type": 9,
  "rare": 2,
  "nameLanText": "青玉盾",
  "DescriptionLanText": "器者装备。\n以青玉为装备，取其碧青高洁之意，望这份光风霁月的品德能为使用者抵挡攻击和灾厄，拨开迷雾，迎来胜利。"
 },
 {
  "id": "30302",
  "type": 9,
  "rare": 2,
  "nameLanText": "青玉剑",
  "DescriptionLanText": "器者装备。\n以青玉为装备，取其碧青高洁之意，饰以龙纹，以玉为剑，以德为器，相信世间再无无法斩断之物。"
 },
 {
  "id": "30303",
  "type": 9,
  "rare": 2,
  "nameLanText": "青玉弩",
  "DescriptionLanText": "器者装备。\n以青玉为装备，取其碧青高洁之意，制成如意弓弩。弩箭锋利，锐不可当，愿君以此弓征战四野，还我辈文明一方安稳。"
 },
 {
  "id": "30304",
  "type": 9,
  "rare": 2,
  "nameLanText": "青玉盘",
  "DescriptionLanText": "器者装备。\n以青玉为装备，取其碧青高洁之意，制成悬盘。曾是衣着配饰，如今化为装备悬浮于手，红光集中聚能，热气可暖手。"
 },
 {
  "id": "30305",
  "type": 9,
  "rare": 2,
  "nameLanText": "青玉炮",
  "DescriptionLanText": "器者装备。\n以青玉为装备，取其碧青高洁之意，制成鼎状短炮。危机四伏，黯夜无光，唯有品德可做勘破迷惘的装备。"
 },
 {
  "id": "30311",
  "type": 9,
  "rare": 3,
  "nameLanText": "青玉盾",
  "DescriptionLanText": "器者装备。\n以青玉为装备，取其碧青高洁之意，望这份光风霁月的品德能为使用者抵挡攻击和灾厄，拨开迷雾，迎来胜利。"
 },
