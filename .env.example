R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Must be an isolated admin-* namespace; never use characters/, skins/, or source/.
R2_MANAGED_ASSET_PREFIX=admin-dev

# Server-only PostgreSQL and admin foundations. Do not expose these with VITE_ prefixes.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_ALLOWED_HOSTS=
DB_HEALTHCHECK_SECRET=
